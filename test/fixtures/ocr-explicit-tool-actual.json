      "description": "Analyze a local image file descriptively with the configured vision model. This output is not executable CAD geometry. Use floorplan_extract_geometry when a source image must drive CAD operations.",
      "parameters": {
        "type": "object",
        "properties": {
          "imagePath": {
            "type": "string",
            "description": "Absolute or home-relative local image path."
          },
          "path": {
            "type": "string",
            "description": "Alias for imagePath."
          },
          "query": {
            "type": "string",
            "description": "What to extract from the image."
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Optional exact model ID admitted by the configured official visual-model catalog for this call only. Omit to keep the user visual preference. Does not change provider or saved settings; no silent model fallback."
          }
        },
        "required": []
      }
    }
